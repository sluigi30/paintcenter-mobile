{
  "expo": {
    "name": "NCM Paint Center",
    "slug": "paintcenter-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "paintcenter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ncm.paintcenter",
      "infoPlist": {
        "NSCameraUsageDescription": "$(PRODUCT_NAME) needs camera access for AR wall detection and paint preview.",
        "NSPhotoLibraryUsageDescription": "$(PRODUCT_NAME) needs access to your photos to save paint previews."
      }
    },
    "android": {
      "package": "com.ncm.paintcenter",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "@reactvision/react-viro",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "NCM Paint Center needs camera access for the live paint filter.",
          "enableFrameProcessors": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableAndroidGpuLibraries": true
        }
      ]
    ]
  }
}
