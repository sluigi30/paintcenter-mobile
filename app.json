{
  "expo": {
    "name": "NCM Paint Center",
    "slug": "paintcenter-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "paintcenter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ncm.paintcenter",
      "infoPlist": {
        "NSCameraUsageDescription": "NCM Paint Center needs camera access for the live paint filter.",
        "NSPhotoLibraryUsageDescription": "$(PRODUCT_NAME) needs access to your photos to save paint previews.",
        "NSPhotoLibraryAddUsageDescription": "Allow $(PRODUCT_NAME) to save photos",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use your microphone"
      }
    },
    "android": {
      "package": "com.ncm.paintcenter",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "@reactvision/react-viro",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "NCM Paint Center needs camera access for the live paint filter.",
          "enableFrameProcessors": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableAndroidGpuLibraries": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dddc1f1b-1692-4031-acd3-c5cf1ac27aba"
      }
    }
  }
}
